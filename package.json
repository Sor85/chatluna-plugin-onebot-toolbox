{
  "name": "chatluna-plugin-onebot-toolbox",
  "version": "0.0.1",
  "description": "为 ChatLuna 提供 OneBot 原生工具与群聊信息变量：修改资料与头像、群名片与头衔、搜索群成员、退群、踢人、处理申请、撤回消息",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sor85/chatluna-plugin-onebot-toolbox.git"
  },
  "homepage": "https://github.com/Sor85/chatluna-plugin-onebot-toolbox#readme",
  "bugs": {
    "url": "https://github.com/Sor85/chatluna-plugin-onebot-toolbox/issues"
  },
  "keywords": [
    "chatluna-plugin",
    "onebot",
    "toolbox",
    "tools",
    "variables"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "sync": "node scripts/sync-to-v2.mjs --once",
    "sync:watch": "node scripts/sync-to-v2.mjs",
    "build": "yakumo build",
    "clean": "yakumo clean",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@chatluna/message": ">=2.0.0-alpha.0",
    "@chatluna/schema": ">=2.0.0-alpha.0",
    "cordis": "^4.0.0-rc.12"
  },
  "devDependencies": {
    "@chatluna/agent": "workspace:*",
    "@chatluna/chat": "workspace:*",
    "@chatluna/message": "workspace:*",
    "@chatluna/prompt": "workspace:*",
    "@chatluna/satori": "workspace:*",
    "@chatluna/schema": "workspace:*",
    "@chatluna/storage-files": "workspace:*",
    "@chatluna/tool": "workspace:*",
    "@satorijs/core": "~4.6.1",
    "cordis": "4.0.0-rc.12",
    "vitest": "^3.2.4"
  },
  "cordis": {
    "description": {
      "en": "OneBot native tools and group-info prompt variables for ChatLuna",
      "zh": "为 ChatLuna 提供 OneBot 原生工具与群聊信息变量"
    },
    "service": {
      "required": [
        "satori",
        "tools",
        "prompt"
      ],
      "optional": [
        "agents",
        "chat",
        "chatluna_storage"
      ]
    }
  }
}
